#Использовать 1commands
#Использовать fs

// OneUnit резолвит #Использовать по имени из своего oscript_modules и системной lib,
// а не из корневого ./oscript_modules. Dev-зависимости jwt-verify / 1connector
// ставятся локально - перед запуском кладём их туда, где oneunit их увидит.
Для Каждого ИмяПакета Из СтрРазделить("jwt-verify,1connector", ",") Цикл

	Источник = ОбъединитьПути("oscript_modules", ИмяПакета);
	Приёмник = ОбъединитьПути("oscript_modules", "oneunit", "oscript_modules", ИмяПакета);

	Если Не ФС.КаталогСуществует(Источник) Тогда
		ВызватьИсключение СтрШаблон(
			"Пакет %1 не найден в oscript_modules. Выполните opm run install.",
			ИмяПакета);
	КонецЕсли;

	Если Не ФС.КаталогСуществует(Приёмник) Тогда
		ФС.КопироватьСодержимоеКаталога(Источник, Приёмник);
	КонецЕсли;

КонецЦикла;

ПутьКОтчету = "out";
ФС.ОбеспечитьПустойКаталог(ПутьКОтчету);

СистемнаяИнформация = Новый СистемнаяИнформация;
ЭтоWindows = Найти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0;

Команда = Новый Команда;
Команда.УстановитьКоманду(?(ЭтоWindows, "oscript_modules\bin\oneunit.bat", "./oscript_modules/bin/oneunit"));
Команда.ДобавитьПараметр("execute");
Команда.ДобавитьПараметр("-d");
Команда.ДобавитьПараметр("./tests");
Команда.ДобавитьПараметр("--junit");
Команда.ДобавитьПараметр(ОбъединитьПути(ПутьКОтчету, "junit.xml"));
Команда.ПоказыватьВыводНемедленно(Истина);

ЗавершитьРаботу(Команда.Исполнить());
