// Проверка не выбрасывает исключение: любой отказ описывается кодом
// и текстом ошибки.

// Булево. Истина, если подпись верна и все проверки пройдены.
Перем Валиден Экспорт;

// Соответствие. Разобранные утверждения (claims). Заполнено только для
// валидного токена - иначе Неопределено, чтобы исключить случайное
// использование непроверенных данных.
Перем ПолезнаяНагрузка Экспорт;

// Соответствие. Разобранный заголовок JOSE, если его удалось прочитать.
Перем Заголовок Экспорт;

// Строка. Машиночитаемый код отказа, например TOKEN_EXPIRED.
Перем КодОшибки Экспорт;

// Строка. Человекочитаемое описание отказа.
Перем Ошибка Экспорт;

Процедура ПриСозданииОбъекта()

	Валиден = Ложь;
	ПолезнаяНагрузка = Неопределено;
	Заголовок = Неопределено;
	КодОшибки = "";
	Ошибка = "";

КонецПроцедуры

// Отмечает результат как успешный.
//
// Параметры:
//   РазобранныйЗаголовок - Соответствие - заголовок JOSE.
//   РазобраннаяНагрузка  - Соответствие - утверждения токена.
//
Процедура ЗаполнитьУспех(Знач РазобранныйЗаголовок, Знач РазобраннаяНагрузка) Экспорт

	Валиден = Истина;
	Заголовок = РазобранныйЗаголовок;
	ПолезнаяНагрузка = РазобраннаяНагрузка;
	КодОшибки = "";
	Ошибка = "";

КонецПроцедуры

// Отмечает результат как отказ.
//
// Параметры:
//   Код     - Строка - машиночитаемый код отказа.
//   Описание - Строка - человекочитаемое описание.
//   РазобранныйЗаголовок - Соответствие - заголовок, если он уже прочитан.
//
Процедура ЗаполнитьОтказ(Знач Код, Знач Описание, Знач РазобранныйЗаголовок = Неопределено) Экспорт

	Валиден = Ложь;
	ПолезнаяНагрузка = Неопределено;
	Заголовок = РазобранныйЗаголовок;
	КодОшибки = Код;
	Ошибка = Описание;

КонецПроцедуры

// Возвращает утверждение валидного токена.
//
// Параметры:
//   Имя           - Строка - имя утверждения, например "sub".
//   ЗначениеПоУмолчанию - Произвольный - значение, если утверждение отсутствует.
//
// Возвращаемое значение:
//   Произвольный - значение утверждения.
//
Функция Утверждение(Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт

	Если ПолезнаяНагрузка = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = ПолезнаяНагрузка.Получить(Имя);

	Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);

КонецФункции

// Выбрасывает исключение, если токен не прошёл проверку.
//
Процедура ВыброситьЕслиНеВалиден() Экспорт

	Если Не Валиден Тогда
		ВызватьИсключение СтрШаблон("JWT: %1 (%2)", Ошибка, КодОшибки);
	КонецЕсли;

КонецПроцедуры
