// Код аутентификации сообщения на основе хеш-функции (RFC 2104):
//   HMAC(K, m) = H((K' XOR opad) || H((K' XOR ipad) || m))
// где K' - ключ, дополненный нулями до размера блока хеш-функции,
// а слишком длинный ключ предварительно хешируется.
//
// Платформа не даёт готового HMAC, поэтому он собран поверх ХешированиеДанных.

Перем РазмерыБлоков;

Процедура ПриСозданииОбъекта()

	// Размер блока в байтах: 512 бит у SHA-256, 1024 бита у SHA-384 и SHA-512
	РазмерыБлоков = Новый Соответствие();
	РазмерыБлоков.Вставить("SHA256", 64);
	РазмерыБлоков.Вставить("SHA384", 128);
	РазмерыБлоков.Вставить("SHA512", 128);

КонецПроцедуры

// Вычисляет HMAC.
//
// Параметры:
//   ИмяХешФункции - Строка - SHA256, SHA384 или SHA512.
//   Ключ          - ДвоичныеДанные, БуферДвоичныхДанных, Строка - секрет.
//   Сообщение     - ДвоичныеДанные, БуферДвоичныхДанных, Строка - данные.
//
// Возвращаемое значение:
//   БуферДвоичныхДанных - значение HMAC.
//
Функция ВычислитьКод(Знач ИмяХешФункции, Знач Ключ, Знач Сообщение) Экспорт

	РазмерБлока = РазмерыБлоков.Получить(ИмяХешФункции);

	Если РазмерБлока = Неопределено Тогда
		ВызватьИсключение СтрШаблон("JWT: неизвестная хеш-функция %1", ИмяХешФункции);
	КонецЕсли;

	КлючБуфер = ВБуфер(Ключ);
	СообщениеБуфер = ВБуфер(Сообщение);

	Если КлючБуфер.Размер > РазмерБлока Тогда
		КлючБуфер = Хешировать(ИмяХешФункции, КлючБуфер);
	КонецЕсли;

	ВнутреннийБлок = Новый БуферДвоичныхДанных(РазмерБлока);
	ВнешнийБлок = Новый БуферДвоичныхДанных(РазмерБлока);

	Для Индекс = 0 По РазмерБлока - 1 Цикл
		БайтКлюча = ?(Индекс < КлючБуфер.Размер, КлючБуфер[Индекс], 0);
		ВнутреннийБлок[Индекс] = ПобитовоеИсключительноеИли(БайтКлюча, 54);  // ipad = 0x36
		ВнешнийБлок[Индекс] = ПобитовоеИсключительноеИли(БайтКлюча, 92);     // opad = 0x5C
	КонецЦикла;

	ВнутреннийХеш = Хешировать(ИмяХешФункции, ВнутреннийБлок.Соединить(СообщениеБуфер));

	Возврат Хешировать(ИмяХешФункции, ВнешнийБлок.Соединить(ВнутреннийХеш));

КонецФункции

// Вычисляет HMAC и возвращает его шестнадцатеричным представлением
// в нижнем регистре.
//
// Параметры:
//   ИмяХешФункции - Строка - SHA256, SHA384 или SHA512.
//   Ключ          - ДвоичныеДанные, БуферДвоичныхДанных, Строка - секрет.
//   Сообщение     - ДвоичныеДанные, БуферДвоичныхДанных, Строка - данные.
//
// Возвращаемое значение:
//   Строка - значение HMAC в шестнадцатеричном виде.
//
Функция ВычислитьКодHex(Знач ИмяХешФункции, Знач Ключ, Знач Сообщение) Экспорт

	Возврат НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ВычислитьКод(ИмяХешФункции, Ключ, Сообщение)));

КонецФункции

// Сравнение за постоянное время: длительность не зависит от позиции первого
// расхождения, поэтому по ней нельзя восстановить корректную подпись.
//
// Параметры:
//   Левый  - БуферДвоичныхДанных - первое значение.
//   Правый - БуферДвоичныхДанных - второе значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значения совпадают.
//
Функция СравнитьЗаПостоянноеВремя(Знач Левый, Знач Правый) Экспорт

	Если Левый.Размер <> Правый.Размер Тогда
		Возврат Ложь;
	КонецЕсли;

	Расхождение = 0;

	Для Индекс = 0 По Левый.Размер - 1 Цикл
		Расхождение = ПобитовоеИли(Расхождение, ПобитовоеИсключительноеИли(Левый[Индекс], Правый[Индекс]));
	КонецЦикла;

	Возврат Расхождение = 0;

КонецФункции

// Сравнение строк за постоянное время. Нужно для подписей, пришедших
// в текстовом виде: обычное сравнение прекращается на первом различии.
//
// Параметры:
//   Левый  - Строка - первое значение.
//   Правый - Строка - второе значение.
//
// Возвращаемое значение:
//   Булево - Истина, если значения совпадают.
//
Функция СравнитьСтрокиЗаПостоянноеВремя(Знач Левый, Знач Правый) Экспорт

	Возврат СравнитьЗаПостоянноеВремя(ВБуфер(Левый), ВБуфер(Правый));

КонецФункции

Функция Хешировать(Знач ИмяХешФункции, Знач Данные)

	Хеш = Новый ХешированиеДанных(ХешФункция[ИмяХешФункции]);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Данные));

	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеш.ХешСумма);

КонецФункции

Функция ВБуфер(Знач Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("БуферДвоичныхДанных") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Значение);
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(
			ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8, Ложь));
	КонецЕсли;

	ВызватьИсключение СтрШаблон("JWT: неподдерживаемый тип данных %1", Строка(ТипЗначения));

КонецФункции
