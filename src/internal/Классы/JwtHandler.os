// Спецификации: RFC 7519 (JWT), RFC 7515 (JWS), RFC 7518 (алгоритмы).

Перем Кодировщик;
Перем КодыАутентификации;
Перем ХешПоАлгоритму;
Перем НачалоЭпохи;
Перем КодыПроверяющего;

Процедура ПриСозданииОбъекта()

	Кодировщик = Новый Base64Url();
	КодыАутентификации = Новый HmacRfc2104();
	НачалоЭпохи = Дата(1970, 1, 1, 0, 0, 0);

	ХешПоАлгоритму = Новый Соответствие();
	ХешПоАлгоритму.Вставить("HS256", "SHA256");
	ХешПоАлгоритму.Вставить("HS384", "SHA384");
	ХешПоАлгоритму.Вставить("HS512", "SHA512");

	КодыПроверяющего = Новый Соответствие();
	КодыПроверяющего.Вставить("malformed", "MALFORMED");
	КодыПроверяющего.Вставить("malformed_claim", "MALFORMED");
	КодыПроверяющего.Вставить("unsupported_header", "UNSUPPORTED_CRITICAL_HEADER");
	КодыПроверяющего.Вставить("alg_not_allowed", "ALGORITHM_NOT_ALLOWED");
	КодыПроверяющего.Вставить("kid_missing", "KEY_ID_MISSING");
	КодыПроверяющего.Вставить("key_not_found", "KEY_NOT_FOUND");
	КодыПроверяющего.Вставить("bad_signature", "INVALID_SIGNATURE");
	КодыПроверяющего.Вставить("expired", "TOKEN_EXPIRED");
	КодыПроверяющего.Вставить("not_yet_valid", "TOKEN_NOT_ACTIVE");
	КодыПроверяющего.Вставить("exp_missing", "MISSING_CLAIM");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Подпись

Функция Подписать(Знач ПолезнаяНагрузка, Знач Секрет, Знач Параметры) Экспорт

	Параметры = ?(Параметры = Неопределено, Новый Структура(), Параметры);

	Алгоритм = ЗначениеПараметра(Параметры, "Алгоритм", "HS256");

	Если ХешПоАлгоритму.Получить(Алгоритм) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("JWT: алгоритм %1 не поддерживается", Алгоритм);
	КонецЕсли;

	Если ПустаяСтрока(Строка(Секрет)) Тогда
		ВызватьИсключение "JWT: секрет не может быть пустым";
	КонецЕсли;

	УтвержденияТокена = ПодготовитьУтверждения(ПолезнаяНагрузка, Параметры);
	ЗаголовокТокена = ПодготовитьЗаголовок(Алгоритм, Параметры);

	ЧастьЗаголовка = Кодировщик.КодироватьСтроку(ВJson(ЗаголовокТокена));
	ЧастьНагрузки = Кодировщик.КодироватьСтроку(ВJson(УтвержденияТокена));

	ПодписываемоеЗначение = ЧастьЗаголовка + "." + ЧастьНагрузки;
	Подпись = ВычислитьПодпись(Алгоритм, Секрет, ПодписываемоеЗначение);

	Возврат ПодписываемоеЗначение + "." + Кодировщик.КодироватьДвоичные(Подпись);

КонецФункции

Функция ПодготовитьУтверждения(Знач ПолезнаяНагрузка, Знач Параметры)

	Результат = ВСоответствие(ПолезнаяНагрузка, "полезная нагрузка");

	Сейчас = ЗначениеПараметра(Параметры, "ТекущееВремя", ТекущееВремя());

	Если ЗначениеПараметра(Параметры, "ДобавлятьВремяВыпуска", Истина) И Результат.Получить("iat") = Неопределено Тогда
		Результат.Вставить("iat", Сейчас);
	КонецЕсли;

	УстановитьУтверждение(Результат, Параметры, "Субъект", "sub");
	УстановитьУтверждение(Результат, Параметры, "Издатель", "iss");
	УстановитьУтверждение(Результат, Параметры, "Аудитория", "aud");
	УстановитьУтверждение(Результат, Параметры, "Идентификатор", "jti");

	ВремяЖизни = ЗначениеПараметра(Параметры, "ВремяЖизни");
	Если ВремяЖизни <> Неопределено Тогда
		ПроверитьОтсутствиеКонфликта(Результат, "exp", "ВремяЖизни");
		Результат.Вставить("exp", Сейчас + ВремяЖизни);
	КонецЕсли;

	ДействителенЧерез = ЗначениеПараметра(Параметры, "ДействителенЧерез");
	Если ДействителенЧерез <> Неопределено Тогда
		ПроверитьОтсутствиеКонфликта(Результат, "nbf", "ДействителенЧерез");
		Результат.Вставить("nbf", Сейчас + ДействителенЧерез);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПодготовитьЗаголовок(Знач Алгоритм, Знач Параметры)

	Результат = Новый Соответствие();
	Результат.Вставить("alg", Алгоритм);
	Результат.Вставить("typ", ЗначениеПараметра(Параметры, "ТипТокена", "JWT"));

	ИдентификаторКлюча = ЗначениеПараметра(Параметры, "ИдентификаторКлюча");
	Если ИдентификаторКлюча <> Неопределено Тогда
		Результат.Вставить("kid", ИдентификаторКлюча);
	КонецЕсли;

	Дополнительные = ЗначениеПараметра(Параметры, "ДополнительныеЗаголовки");
	Если Дополнительные <> Неопределено Тогда
		Для Каждого Элемент Из ВСоответствие(Дополнительные, "дополнительные заголовки") Цикл
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Проверка

Функция Проверить(Знач Токен, Знач Секрет, Знач Параметры) Экспорт

	Параметры = ?(Параметры = Неопределено, Новый Структура(), Параметры);
	Результат = Новый JwtVerificationResult();

	Если ТипЗнч(Токен) <> Тип("Строка") Или ПустаяСтрока(Токен) Тогда
		Результат.ЗаполнитьОтказ("MALFORMED", "Токен не задан");
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(Токен, ".", Истина);

	Если Части.Количество() <> 3 Тогда
		Результат.ЗаполнитьОтказ("MALFORMED",
			СтрШаблон("Ожидается три части, разделённые точкой, получено %1", Части.Количество()));
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЗаголовокТокена = ИзJson(Кодировщик.ДекодироватьВСтроку(Части[0]));
	Исключение
		Результат.ЗаполнитьОтказ("MALFORMED", "Заголовок не является корректным JSON");
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(ЗаголовокТокена) <> Тип("Соответствие") Тогда
		Результат.ЗаполнитьОтказ("MALFORMED", "Заголовок не является объектом JSON");
		Возврат Результат;
	КонецЕсли;

	ОтказЗаголовка = ПроверитьЗаголовок(ЗаголовокТокена, Параметры);
	Если ОтказЗаголовка <> Неопределено Тогда
		Результат.ЗаполнитьОтказ(ОтказЗаголовка.Код, ОтказЗаголовка.Описание, ЗаголовокТокена);
		Возврат Результат;
	КонецЕсли;

	Если Не ПодписьВерна(ЗаголовокТокена["alg"], Секрет, Части) Тогда
		Результат.ЗаполнитьОтказ("INVALID_SIGNATURE", "Подпись не соответствует токену", ЗаголовокТокена);
		Возврат Результат;
	КонецЕсли;

	Попытка
		УтвержденияТокена = ИзJson(Кодировщик.ДекодироватьВСтроку(Части[1]));
	Исключение
		Результат.ЗаполнитьОтказ("MALFORMED", "Полезная нагрузка не является корректным JSON", ЗаголовокТокена);
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(УтвержденияТокена) <> Тип("Соответствие") Тогда
		Результат.ЗаполнитьОтказ("MALFORMED", "Полезная нагрузка не является объектом JSON", ЗаголовокТокена);
		Возврат Результат;
	КонецЕсли;

	ОтказУтверждений = ПроверитьУтверждения(УтвержденияТокена, Параметры);
	Если ОтказУтверждений <> Неопределено Тогда
		Результат.ЗаполнитьОтказ(ОтказУтверждений.Код, ОтказУтверждений.Описание, ЗаголовокТокена);
		Возврат Результат;
	КонецЕсли;

	Результат.ЗаполнитьУспех(ЗаголовокТокена, УтвержденияТокена);

	Возврат Результат;

КонецФункции

// Проверка асимметрично подписанного токена внешним проверяющим:
// подпись проверяет переданный объект, утверждения - этот класс.
//
Функция ПроверитьАсимметричный(Знач Токен, Знач Проверяющий, Знач Параметры) Экспорт

	Параметры = ?(Параметры = Неопределено, Новый Структура(), Параметры);
	Результат = Новый JwtVerificationResult();

	Если Проверяющий = Неопределено Тогда
		ВызватьИсключение "JWT: проверяющий подписи не задан";
	КонецЕсли;

	Попытка
		Итог = Проверяющий.Проверить(Токен);
	Исключение
		Результат.ЗаполнитьОтказ("VERIFIER_FAILED",
			СтрШаблон("Проверяющий подписи не смог обработать токен: %1",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Результат;
	КонецПопытки;

	Если Не Итог.Успех Тогда
		Результат.ЗаполнитьОтказ(КодОтказаПроверяющего(Итог.Код), Строка(Итог.Сообщение), Итог.Заголовок);
		Возврат Результат;
	КонецЕсли;

	// Параметр Алгоритмы сужает белый список проверяющего, а не заменяет его
	Разрешённые = ЗначениеПараметра(Параметры, "Алгоритмы");
	Если Разрешённые <> Неопределено И ВМассивСтрок(Разрешённые).Найти(Строка(Итог.Алгоритм)) = Неопределено Тогда
		Результат.ЗаполнитьОтказ("ALGORITHM_NOT_ALLOWED",
			СтрШаблон("Алгоритм %1 не входит в список разрешённых", Итог.Алгоритм), Итог.Заголовок);
		Возврат Результат;
	КонецЕсли;

	ОжидаемыйТип = ЗначениеПараметра(Параметры, "ТипТокена");
	Если ОжидаемыйТип <> Неопределено Тогда
		ТипТокена = ?(Итог.Заголовок = Неопределено, Неопределено, Итог.Заголовок.Получить("typ"));
		Если ТипТокена = Неопределено Или ВРег(Строка(ТипТокена)) <> ВРег(ОжидаемыйТип) Тогда
			Результат.ЗаполнитьОтказ("INVALID_TYPE",
				СтрШаблон("Ожидался тип токена %1", ОжидаемыйТип), Итог.Заголовок);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	ОтказУтверждений = ПроверитьУтверждения(Итог.Клеймы, Параметры);
	Если ОтказУтверждений <> Неопределено Тогда
		Результат.ЗаполнитьОтказ(ОтказУтверждений.Код, ОтказУтверждений.Описание, Итог.Заголовок);
		Возврат Результат;
	КонецЕсли;

	Результат.ЗаполнитьУспех(Итог.Заголовок, Итог.Клеймы);

	Возврат Результат;

КонецФункции

Функция КодОтказаПроверяющего(Знач Код)

	Известный = КодыПроверяющего.Получить(Строка(Код));

	Возврат ?(Известный = Неопределено, "VERIFICATION_FAILED", Известный);

КонецФункции

Функция ПроверитьЗаголовок(Знач ЗаголовокТокена, Знач Параметры)

	Алгоритм = ЗаголовокТокена.Получить("alg");

	Если Алгоритм = Неопределено Тогда
		Возврат Отказ("MALFORMED", "В заголовке отсутствует alg");
	КонецЕсли;

	// RFC 7515, раздел 4.1.11: расширения, помеченные критическими, обязаны быть
	// поняты проверяющей стороной. Ни одно расширение не поддерживается,
	// поэтому такой токен безопаснее отвергнуть.
	Если ЗаголовокТокена.Получить("crit") <> Неопределено Тогда
		Возврат Отказ("UNSUPPORTED_CRITICAL_HEADER", "Заголовок crit не поддерживается");
	КонецЕсли;

	// Алгоритм none позволяет подделать любой токен, поэтому запрещён всегда.
	Если ВРег(Строка(Алгоритм)) = "NONE" Тогда
		Возврат Отказ("ALGORITHM_NOT_ALLOWED", "Алгоритм none запрещён");
	КонецЕсли;

	Если ХешПоАлгоритму.Получить(Алгоритм) = Неопределено Тогда
		Возврат Отказ("UNSUPPORTED_ALGORITHM", СтрШаблон("Алгоритм %1 не поддерживается", Алгоритм));
	КонецЕсли;

	// Список разрешённых алгоритмов задаёт проверяющая сторона: доверять
	// значению alg из самого токена нельзя.
	Разрешённые = ЗначениеПараметра(Параметры, "Алгоритмы", АлгоритмыПоУмолчанию());

	Если Разрешённые.Найти(Алгоритм) = Неопределено Тогда
		Возврат Отказ("ALGORITHM_NOT_ALLOWED",
			СтрШаблон("Алгоритм %1 не входит в список разрешённых", Алгоритм));
	КонецЕсли;

	ОжидаемыйТип = ЗначениеПараметра(Параметры, "ТипТокена");
	Если ОжидаемыйТип <> Неопределено Тогда
		ТипТокена = ЗаголовокТокена.Получить("typ");
		Если ТипТокена = Неопределено Или ВРег(Строка(ТипТокена)) <> ВРег(ОжидаемыйТип) Тогда
			Возврат Отказ("INVALID_TYPE", СтрШаблон("Ожидался тип токена %1", ОжидаемыйТип));
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПроверитьУтверждения(Знач УтвержденияТокена, Знач Параметры)

	Сейчас = ЗначениеПараметра(Параметры, "ТекущееВремя", ТекущееВремя());
	Допуск = ЗначениеПараметра(Параметры, "Допуск", 0);

	Если ЗначениеПараметра(Параметры, "ПроверятьСрок", Истина) Тогда

		Отклонение = ПроверитьСрокиДействия(УтвержденияТокена, Параметры, Сейчас, Допуск);
		Если Отклонение <> Неопределено Тогда
			Возврат Отклонение;
		КонецЕсли;

	КонецЕсли;

	Если ЗначениеПараметра(Параметры, "ТребоватьВремяВыпуска", Ложь) И УтвержденияТокена.Получить("iat") = Неопределено Тогда
		Возврат Отказ("MISSING_CLAIM", "Отсутствует обязательное утверждение iat");
	КонецЕсли;

	Отклонение = ПроверитьИздателя(УтвержденияТокена, Параметры);
	Если Отклонение <> Неопределено Тогда
		Возврат Отклонение;
	КонецЕсли;

	Отклонение = ПроверитьАудиторию(УтвержденияТокена, Параметры);
	Если Отклонение <> Неопределено Тогда
		Возврат Отклонение;
	КонецЕсли;

	ОжидаемыйСубъект = ЗначениеПараметра(Параметры, "Субъект");
	Если ОжидаемыйСубъект <> Неопределено И Строка(УтвержденияТокена.Получить("sub")) <> Строка(ОжидаемыйСубъект) Тогда
		Возврат Отказ("INVALID_SUBJECT", "Утверждение sub не совпадает с ожидаемым");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПроверитьСрокиДействия(Знач УтвержденияТокена, Знач Параметры, Знач Сейчас, Знач Допуск)

	СрокДействия = ЧисловоеУтверждение(УтвержденияТокена, "exp");

	Если СрокДействия = Неопределено Тогда
		Если ЗначениеПараметра(Параметры, "ТребоватьСрок", Ложь) Тогда
			Возврат Отказ("MISSING_CLAIM", "Отсутствует обязательное утверждение exp");
		КонецЕсли;
	ИначеЕсли Сейчас - Допуск >= СрокДействия Тогда
		Возврат Отказ("TOKEN_EXPIRED", "Срок действия токена истёк");
	КонецЕсли;

	ДействителенС = ЧисловоеУтверждение(УтвержденияТокена, "nbf");

	Если ДействителенС = Неопределено Тогда
		Если ЗначениеПараметра(Параметры, "ТребоватьДействителенС", Ложь) Тогда
			Возврат Отказ("MISSING_CLAIM", "Отсутствует обязательное утверждение nbf");
		КонецЕсли;
	ИначеЕсли Сейчас + Допуск < ДействителенС Тогда
		Возврат Отказ("TOKEN_NOT_ACTIVE", "Токен ещё не вступил в силу");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПроверитьИздателя(Знач УтвержденияТокена, Знач Параметры)

	Ожидаемый = ЗначениеПараметра(Параметры, "Издатель");

	Если Ожидаемый = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Издатель = УтвержденияТокена.Получить("iss");

	Если Издатель = Неопределено Тогда
		Возврат Отказ("INVALID_ISSUER", "Утверждение iss отсутствует");
	КонецЕсли;

	Если ВМассивСтрок(Ожидаемый).Найти(Строка(Издатель)) = Неопределено Тогда
		Возврат Отказ("INVALID_ISSUER", "Утверждение iss не совпадает с ожидаемым");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// RFC 7519, раздел 4.1.3: aud - либо строка, либо массив строк.
// Проверка считается пройденной, если ожидаемое значение входит в множество.
//
Функция ПроверитьАудиторию(Знач УтвержденияТокена, Знач Параметры)

	Ожидаемая = ЗначениеПараметра(Параметры, "Аудитория");

	Если Ожидаемая = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Аудитория = УтвержденияТокена.Получить("aud");

	Если Аудитория = Неопределено Тогда
		Возврат Отказ("INVALID_AUDIENCE", "Утверждение aud отсутствует");
	КонецЕсли;

	ФактическиеЗначения = ВМассивСтрок(Аудитория);

	Для Каждого ОжидаемоеЗначение Из ВМассивСтрок(Ожидаемая) Цикл
		Если ФактическиеЗначения.Найти(ОжидаемоеЗначение) <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Отказ("INVALID_AUDIENCE", "Утверждение aud не совпадает с ожидаемым");

КонецФункции

Функция ПодписьВерна(Знач Алгоритм, Знач Секрет, Знач Части)

	Попытка
		ФактическаяПодпись = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(
			Кодировщик.ДекодироватьВДвоичные(Части[2]));
	Исключение
		Возврат Ложь;
	КонецПопытки;

	ОжидаемаяПодпись = ВычислитьПодпись(Алгоритм, Секрет, Части[0] + "." + Части[1]);

	Возврат КодыАутентификации.СравнитьЗаПостоянноеВремя(ОжидаемаяПодпись, ФактическаяПодпись);

КонецФункции

Функция ВычислитьПодпись(Знач Алгоритм, Знач Секрет, Знач ПодписываемоеЗначение)

	Возврат КодыАутентификации.ВычислитьКод(ХешПоАлгоритму[Алгоритм], Секрет, ПодписываемоеЗначение);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Разбор без проверки

Функция Разобрать(Знач Токен) Экспорт

	Если ТипЗнч(Токен) <> Тип("Строка") Тогда
		ВызватьИсключение "JWT: токен должен быть строкой";
	КонецЕсли;

	Части = СтрРазделить(Токен, ".", Истина);

	Если Части.Количество() <> 3 Тогда
		ВызватьИсключение "JWT: некорректный формат токена";
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", ИзJson(Кодировщик.ДекодироватьВСтроку(Части[0])));
	Результат.Вставить("ПолезнаяНагрузка", ИзJson(Кодировщик.ДекодироватьВСтроку(Части[1])));

	Возврат Результат;

КонецФункции

Функция ПоддерживаемыеАлгоритмы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("HS256");
	Результат.Добавить("HS384");
	Результат.Добавить("HS512");

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Вспомогательные

Функция АлгоритмыПоУмолчанию()

	Возврат ПоддерживаемыеАлгоритмы();

КонецФункции

Функция ТекущееВремя() Экспорт

	Возврат Цел(ТекущаяУниверсальнаяДата() - НачалоЭпохи);

КонецФункции

Функция Отказ(Знач Код, Знач Описание)

	Результат = Новый Структура();
	Результат.Вставить("Код", Код);
	Результат.Вставить("Описание", Описание);

	Возврат Результат;

КонецФункции

Функция ЧисловоеУтверждение(Знач УтвержденияТокена, Знач Имя)

	Значение = УтвержденияТокена.Получить(Имя);

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура УстановитьУтверждение(УтвержденияТокена, Знач Параметры, Знач ИмяПараметра, Знач ИмяУтверждения)

	Значение = ЗначениеПараметра(Параметры, ИмяПараметра);

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПроверитьОтсутствиеКонфликта(УтвержденияТокена, ИмяУтверждения, ИмяПараметра);
	УтвержденияТокена.Вставить(ИмяУтверждения, Значение);

КонецПроцедуры

// Утверждение, заданное и в полезной нагрузке, и параметром, считается ошибкой,
// а не поводом для молчаливой перезаписи.
//
Процедура ПроверитьОтсутствиеКонфликта(Знач УтвержденияТокена, Знач ИмяУтверждения, Знач ИмяПараметра)

	Если УтвержденияТокена.Получить(ИмяУтверждения) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"JWT: утверждение %1 задано и в полезной нагрузке, и параметром %2",
			ИмяУтверждения, ИмяПараметра);
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеПараметра(Знач Параметры, Знач Имя, Знач ЗначениеПоУмолчанию = Неопределено)

	Если Параметры = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Значение = Параметры.Получить(Имя);
		Возврат ?(Значение = Неопределено, ЗначениеПоУмолчанию, Значение);
	КонецЕсли;

	Значение = Неопределено;
	Если Параметры.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ВМассивСтрок(Знач Значение)

	Результат = Новый Массив();

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Строка(Элемент));
		КонецЦикла;
	Иначе
		Результат.Добавить(Строка(Значение));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВСоответствие(Знач Значение, Знач Назначение)

	Результат = Новый Соответствие();

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Строка(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	Иначе
		ВызватьИсключение СтрШаблон("JWT: %1 должна быть структурой или соответствием", Назначение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВJson(Знач Значение)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Функция ИзJson(Знач Текст)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);

	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

