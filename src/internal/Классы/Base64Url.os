// Спецификация: RFC 7515, Appendix C (JSON Web Signature): "+" заменяется
// на "-", "/" - на "_", хвостовые "=" отбрасываются.

// Параметры:
//   Значение - ДвоичныеДанные, БуферДвоичныхДанных - данные для кодирования.
//
// Возвращаемое значение:
//   Строка - представление base64url.
//
Функция КодироватьДвоичные(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("БуферДвоичныхДанных") Тогда
		Значение = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Значение);
	КонецЕсли;

	Результат = Base64Строка(Значение);

	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Результат = СтрЗаменить(Результат, " ", "");

	Результат = СтрЗаменить(Результат, "+", "-");
	Результат = СтрЗаменить(Результат, "/", "_");

	Возврат ОтброситьВыравнивание(Результат);

КонецФункции

// Параметры:
//   Значение - Строка - текст, который кодируется в UTF-8 и далее в base64url.
//
// Возвращаемое значение:
//   Строка - представление base64url.
//
Функция КодироватьСтроку(Знач Значение) Экспорт

	Возврат КодироватьДвоичные(ПолучитьДвоичныеДанныеИзСтроки(Значение, КодировкаТекста.UTF8, Ложь));

КонецФункции

// Параметры:
//   Значение - Строка - представление base64url.
//
// Возвращаемое значение:
//   ДвоичныеДанные - декодированные данные.
//
Функция ДекодироватьВДвоичные(Знач Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "JWT: ожидается строка base64url";
	КонецЕсли;

	Подготовленное = СтрЗаменить(Значение, "-", "+");
	Подготовленное = СтрЗаменить(Подготовленное, "_", "/");

	ОстатокДлины = СтрДлина(Подготовленное) % 4;

	Если ОстатокДлины = 2 Тогда
		Подготовленное = Подготовленное + "==";
	ИначеЕсли ОстатокДлины = 3 Тогда
		Подготовленное = Подготовленное + "=";
	ИначеЕсли ОстатокДлины = 1 Тогда
		ВызватьИсключение "JWT: некорректная длина строки base64url";
	КонецЕсли;

	Попытка
		Возврат Base64Значение(Подготовленное);
	Исключение
		ВызватьИсключение "JWT: строка не является корректным base64url";
	КонецПопытки;

КонецФункции

// Параметры:
//   Значение - Строка - представление base64url.
//
// Возвращаемое значение:
//   Строка - декодированный текст в UTF-8.
//
Функция ДекодироватьВСтроку(Знач Значение) Экспорт

	Возврат ПолучитьСтрокуИзДвоичныхДанных(ДекодироватьВДвоичные(Значение), КодировкаТекста.UTF8);

КонецФункции

Функция ОтброситьВыравнивание(Знач Значение)

	Пока СтрДлина(Значение) > 0 И Прав(Значение, 1) = "=" Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;

	Возврат Значение;

КонецФункции
