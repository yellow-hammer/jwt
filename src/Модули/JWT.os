// Спецификации: RFC 7519 (JWT), RFC 7515 (JWS), RFC 7518 (алгоритмы).

#Использовать "../internal"

Перем КэшОбработчика;

// Создаёт подписанный токен.
//
// Параметры:
//   ПолезнаяНагрузка - Структура, Соответствие - утверждения (claims).
//   Секрет           - Строка, ДвоичныеДанные - общий секрет для HMAC.
//   Параметры        - Структура, Соответствие - настройки подписи:
//     * Алгоритм              - Строка  - HS256 (по умолчанию), HS384, HS512.
//     * ВремяЖизни            - Число   - срок жизни в секундах, заполняет exp.
//     * ДействителенЧерез     - Число   - задержка вступления в силу, заполняет nbf.
//     * Издатель              - Строка  - заполняет iss.
//     * Аудитория             - Строка, Массив - заполняет aud.
//     * Субъект               - Строка  - заполняет sub.
//     * Идентификатор         - Строка  - заполняет jti.
//     * ДобавлятьВремяВыпуска - Булево  - заполнять iat, по умолчанию Истина.
//     * ИдентификаторКлюча    - Строка  - заполняет заголовок kid.
//     * ТипТокена             - Строка  - заголовок typ, по умолчанию JWT.
//     * ДополнительныеЗаголовки - Структура, Соответствие - прочие заголовки JOSE.
//     * ТекущееВремя          - Число   - подменяет текущее время (для тестов).
//
// Возвращаемое значение:
//   Строка - токен в компактной сериализации JWS.
//
Функция Подписать(Знач ПолезнаяНагрузка, Знач Секрет, Знач Параметры = Неопределено) Экспорт

	Возврат Обработчик().Подписать(ПолезнаяНагрузка, Секрет, Параметры);

КонецФункции

// Проверяет подпись и утверждения токена.
// Функция не выбрасывает исключений: причина отказа возвращается в результате.
//
// Параметры:
//   Токен     - Строка - токен в компактной сериализации JWS.
//   Секрет    - Строка, ДвоичныеДанные - общий секрет для HMAC.
//   Параметры - Структура, Соответствие - настройки проверки:
//     * Алгоритмы             - Массив  - разрешённые алгоритмы.
//                                         По умолчанию HS256, HS384, HS512.
//     * ПроверятьСрок         - Булево  - проверять exp и nbf, по умолчанию Истина.
//     * Допуск                - Число   - допустимое расхождение часов в секундах.
//     * Издатель              - Строка, Массив - ожидаемое значение iss.
//     * Аудитория             - Строка, Массив - ожидаемое значение aud.
//     * Субъект               - Строка  - ожидаемое значение sub.
//     * ТипТокена             - Строка  - ожидаемое значение заголовка typ.
//     * ТребоватьСрок         - Булево  - считать отсутствие exp ошибкой.
//     * ТребоватьДействителенС - Булево - считать отсутствие nbf ошибкой.
//     * ТребоватьВремяВыпуска - Булево  - считать отсутствие iat ошибкой.
//     * ТекущееВремя          - Число   - подменяет текущее время (для тестов).
//
// Возвращаемое значение:
//   JwtVerificationResult - результат с полями Валиден, ПолезнаяНагрузка,
//                          Заголовок, КодОшибки, Ошибка.
//
Функция Проверить(Знач Токен, Знач Секрет, Знач Параметры = Неопределено) Экспорт

	Возврат Обработчик().Проверить(Токен, Секрет, Параметры);

КонецФункции

// Проверяет утверждения токена, подпись которого проверяет внешний объект.
//
// Проверяющим годится любой объект с методом Проверить(Токен), возвращающим
// структуру с полями Успех, Код, Сообщение, Алгоритм, Заголовок и Клеймы.
//
// Параметры:
//   Токен       - Строка - токен в компактной сериализации JWS.
//   Проверяющий - Произвольный - объект, проверяющий подпись, например
//                                ПроверяющийJWS из пакета jwt-verify.
//   Параметры   - Структура, Соответствие - настройки проверки утверждений,
//                 те же, что у функции Проверить. Параметр Алгоритмы здесь
//                 сужает белый список проверяющего, а не задаёт его.
//
// Возвращаемое значение:
//   JwtVerificationResult - результат с полями Валиден, ПолезнаяНагрузка,
//                          Заголовок, КодОшибки, Ошибка.
//
Функция ПроверитьАсимметричный(Знач Токен, Знач Проверяющий, Знач Параметры = Неопределено) Экспорт

	Возврат Обработчик().ПроверитьАсимметричный(Токен, Проверяющий, Параметры);

КонецФункции

// Разбирает токен БЕЗ проверки подписи.
//
// Полученным данным нельзя доверять: любой может подменить содержимое токена.
// Используйте только для диагностики и для чтения kid перед выбором ключа.
//
// Параметры:
//   Токен - Строка - токен в компактной сериализации JWS.
//
// Возвращаемое значение:
//   Структура - поля Заголовок и ПолезнаяНагрузка (оба Соответствие).
//
Функция Разобрать(Знач Токен) Экспорт

	Возврат Обработчик().Разобрать(Токен);

КонецФункции

// Список алгоритмов, которые поддерживает библиотека.
//
// Возвращаемое значение:
//   Массив - строки HS256, HS384, HS512.
//
Функция ПоддерживаемыеАлгоритмы() Экспорт

	Возврат Обработчик().ПоддерживаемыеАлгоритмы();

КонецФункции

// Текущее время в формате NumericDate (RFC 7519, раздел 2):
// секунды, прошедшие с 1970-01-01T00:00:00Z.
//
// Возвращаемое значение:
//   Число - метка времени.
//
Функция ТекущееВремя() Экспорт

	Возврат Обработчик().ТекущееВремя();

КонецФункции

Функция Обработчик()

	Если КэшОбработчика = Неопределено Тогда
		КэшОбработчика = Новый JwtHandler();
	КонецЕсли;

	Возврат КэшОбработчика;

КонецФункции
