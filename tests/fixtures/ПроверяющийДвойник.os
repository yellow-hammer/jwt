Перем Итог;
Перем БросатьИсключение;

Процедура ПриСозданииОбъекта()

	БросатьИсключение = Ложь;
	Итог = НовыйИтог();

КонецПроцедуры

// Задаёт успешный итог.
//
// Параметры:
//   Клеймы    - Соответствие - утверждения токена.
//   Заголовок - Соответствие - заголовок JOSE.
//   Алгоритм  - Строка - алгоритм подписи.
//
Процедура ВернутьУспех(Знач Клеймы, Знач Заголовок = Неопределено, Знач Алгоритм = "RS256") Экспорт

	Итог = НовыйИтог();
	Итог.Успех = Истина;
	Итог.Код = "ok";
	Итог.Алгоритм = Алгоритм;
	Итог.Заголовок = ?(Заголовок = Неопределено, ЗаголовокПоУмолчанию(Алгоритм), Заголовок);
	Итог.Клеймы = Клеймы;

КонецПроцедуры

// Задаёт отказ с кодом словаря jwt-verify.
//
// Параметры:
//   Код       - Строка - код отказа, например bad_signature.
//   Сообщение - Строка - пояснение.
//
Процедура ВернутьОтказ(Знач Код, Знач Сообщение = "") Экспорт

	Итог = НовыйИтог();
	Итог.Код = Код;
	Итог.Сообщение = Сообщение;

КонецПроцедуры

// Заставляет метод Проверить выбросить исключение.
//
Процедура Падать() Экспорт

	БросатьИсключение = Истина;

КонецПроцедуры

Функция Проверить(Знач Токен) Экспорт

	Если БросатьИсключение Тогда
		ВызватьИсключение "Транспорт недоступен";
	КонецЕсли;

	Возврат Итог;

КонецФункции

////////////////////////////////////////////////////////////////////////////////

Функция НовыйИтог()

	Результат = Новый Структура("Успех, Код, Сообщение, Алгоритм, Идентификатор, Заголовок, Клеймы",
		Ложь, "malformed", "", "", "", Неопределено, Неопределено);

	Возврат Результат;

КонецФункции

Функция ЗаголовокПоУмолчанию(Знач Алгоритм)

	Результат = Новый Соответствие();
	Результат.Вставить("alg", Алгоритм);
	Результат.Вставить("typ", "JWT");
	Результат.Вставить("kid", "ключ-1");

	Возврат Результат;

КонецФункции
