#Использовать asserts
#Использовать jwt-verify
#Использовать "../src"

Перем Токены;

&ПередКаждым
Процедура ПрочитатьТокены() Экспорт

	Токены = ПрочитатьФикстуру("токены-асимметричные.json");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Своя половина работы

&Тест
&ОтображаемоеИмя("Успешный итог проверяющего даёт валидный результат с нагрузкой")
Процедура УспехДаётНагрузку() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения());

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник);

	Ожидаем.Что(Результат.Валиден, Результат.Ошибка).ЭтоИстина();
	Ожидаем.Что(Результат.ПолезнаяНагрузка["sub"]).Равно("user-42");
	Ожидаем.Что(Результат.Заголовок["kid"]).Равно("ключ-1");
	Ожидаем.Что(Результат.КодОшибки).Равно("");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Ожидания принимающей стороны проверяются поверх подписи")
Процедура УтвержденияПроверяютсяПоверх() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения());

	Параметры = Новый Структура();
	Параметры.Вставить("Издатель", "https://issuer.example");
	Параметры.Вставить("Аудитория", "oneflag");
	Параметры.Вставить("Субъект", "user-42");
	Параметры.Вставить("ТекущееВремя", 1500000000);

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник, Параметры);

	Ожидаем.Что(Результат.Валиден, Результат.Ошибка).ЭтоИстина();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Чужой издатель отвергается, хотя подпись верна")
Процедура ЧужойИздательОтвергается() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения());

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник,
		Новый Структура("Издатель", "https://another.example"));

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("INVALID_ISSUER");
	Ожидаем.Что(Результат.ПолезнаяНагрузка).Равно(Неопределено);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Чужая аудитория отвергается")
Процедура ЧужаяАудиторияОтвергается() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения());

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник,
		Новый Структура("Аудитория", "другой-сервис"));

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("INVALID_AUDIENCE");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Срок действия считается по времени принимающей стороны")
Процедура СрокСчитаетсяПоНашимЧасам() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения());

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник,
		Новый Структура("ТекущееВремя", 2100000000));

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("TOKEN_EXPIRED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Список алгоритмов сужает белый список проверяющего")
Процедура СписокАлгоритмовСужаетБелыйСписок() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения(), Неопределено, "RS512");

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник,
		Новый Структура("Алгоритмы", "RS256"));

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("ALGORITHM_NOT_ALLOWED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Несовпадение typ отвергается")
Процедура НесовпадениеТипаОтвергается() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьУспех(Утверждения());

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник,
		Новый Структура("ТипТокена", "at+jwt"));

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("INVALID_TYPE");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Перевод отказов

&Тест
&ОтображаемоеИмя("Коды отказа переводятся в словарь библиотеки")
Процедура КодыОтказаПереводятся() Экспорт

	ОжидаемыеКоды = Новый Соответствие();
	ОжидаемыеКоды.Вставить("bad_signature", "INVALID_SIGNATURE");
	ОжидаемыеКоды.Вставить("expired", "TOKEN_EXPIRED");
	ОжидаемыеКоды.Вставить("not_yet_valid", "TOKEN_NOT_ACTIVE");
	ОжидаемыеКоды.Вставить("kid_missing", "KEY_ID_MISSING");
	ОжидаемыеКоды.Вставить("key_not_found", "KEY_NOT_FOUND");
	ОжидаемыеКоды.Вставить("alg_not_allowed", "ALGORITHM_NOT_ALLOWED");
	ОжидаемыеКоды.Вставить("unsupported_header", "UNSUPPORTED_CRITICAL_HEADER");
	ОжидаемыеКоды.Вставить("malformed", "MALFORMED");
	ОжидаемыеКоды.Вставить("exp_missing", "MISSING_CLAIM");

	Для Каждого Пара Из ОжидаемыеКоды Цикл

		Двойник = Двойник();
		Двойник.ВернутьОтказ(Пара.Ключ, "причина");

		Результат = JWT.ПроверитьАсимметричный("токен", Двойник);

		Ожидаем.Что(Результат.КодОшибки, Пара.Ключ).Равно(Пара.Значение);
		Ожидаем.Что(Результат.Ошибка).Равно("причина");

	КонецЦикла;

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Незнакомый код отказа не теряется")
Процедура НезнакомыйКодНеТеряется() Экспорт

	Двойник = Двойник();
	Двойник.ВернутьОтказ("совсем_новый_код", "что-то пошло не так");

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник);

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("VERIFICATION_FAILED");
	Ожидаем.Что(Результат.Ошибка).Равно("что-то пошло не так");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Сбой проверяющего становится отказом, а не исключением")
Процедура СбойПроверяющегоСтановитсяОтказом() Экспорт

	Двойник = Двойник();
	Двойник.Падать();

	Результат = JWT.ПроверитьАсимметричный("токен", Двойник);

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("VERIFIER_FAILED");
	Ожидаем.Что(СтрНайти(Результат.Ошибка, "Транспорт недоступен")).Больше(0);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Отсутствие проверяющего - ошибка вызова, а не свойство токена")
Процедура ОтсутствиеПроверяющегоВызываетИсключение() Экспорт

	Попытка
		JWT.ПроверитьАсимметричный("токен", Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "проверяющий подписи не задан")).Больше(0);
	КонецПопытки;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Контракт с настоящим jwt-verify

&Тест
&ОтображаемоеИмя("Токен HMAC не проходит асимметричную проверку")
Процедура ТокенHmacНеПроходит() Экспорт

	Токен = JWT.Подписать(Утверждения(), "секрет");

	Результат = JWT.ПроверитьАсимметричный(Токен, Новый ПроверяющийJWS());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("ALGORITHM_NOT_ALLOWED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Токен без kid отвергается: выбирать ключ нечем")
Процедура ТокенБезKidОтвергается() Экспорт

	Результат = JWT.ПроверитьАсимметричный(Токены["rs256_без_kid"], Новый ПроверяющийJWS());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("KEY_ID_MISSING");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Без источника ключей проверка отказывает, а не падает")
Процедура БезИсточникаКлючейОтказ() Экспорт

	Результат = JWT.ПроверитьАсимметричный(Токены["rs256_без_ключа"], Новый ПроверяющийJWS());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("KEY_NOT_FOUND");
	Ожидаем.Что(Результат.Заголовок["kid"]).Равно("ключ-1");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Мусор вместо токена даёт MALFORMED")
Процедура МусорДаётMalformed() Экспорт

	Результат = JWT.ПроверитьАсимметричный(Токены["не_токен"], Новый ПроверяющийJWS());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("MALFORMED");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция Двойник()

	Возврат ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур(), "ПроверяющийДвойник.os"));

КонецФункции

Функция Утверждения()

	Результат = Новый Соответствие();
	Результат.Вставить("iss", "https://issuer.example");
	Результат.Вставить("aud", "oneflag");
	Результат.Вставить("sub", "user-42");
	Результат.Вставить("exp", 2000000000);

	Возврат Результат;

КонецФункции

Функция ПрочитатьФикстуру(Знач ИмяФайла)

	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ОбъединитьПути(КаталогФикстур(), ИмяФайла));
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Значение;

КонецФункции

Функция КаталогФикстур()

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");

КонецФункции
