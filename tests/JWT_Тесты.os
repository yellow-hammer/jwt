&Тест
&ОтображаемоеИмя("Конфликт утверждения в нагрузке и в параметрах отвергается")
Процедура КонфликтУтвержденийОтвергается() Экспорт

	Нагрузка = Новый Соответствие();
	Нагрузка.Вставить("exp", 1700000000);

	Параметры = Новый Массив();
	Параметры.Добавить(Нагрузка);
	Параметры.Добавить(Секрет());
	Параметры.Добавить(Новый Структура("ВремяЖизни", 3600));

	Ожидаем.Что(JWT).Метод("Подписать", Параметры).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("ВыброситьЕслиНеВалиден поднимает исключение для невалидного токена")
Процедура ВыбросИсключенияДляНевалидногоТокена() Экспорт

	Результат = JWT.Проверить("мусор", Секрет());

	Ожидаем.Что(Результат).Метод("ВыброситьЕслиНеВалиден", Новый Массив()).ВыбрасываетИсключение();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Утверждение возвращает значение по умолчанию, если его нет")
Процедура УтверждениеСоЗначениемПоУмолчанию() Экспорт

	Результат = JWT.Проверить(JWT.Подписать(Новый Структура("sub", "u"), Секрет()), Секрет());

	Ожидаем.Что(Результат.Утверждение("sub")).Равно("u");
	Ожидаем.Что(Результат.Утверждение("role", "viewer")).Равно("viewer");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Разбор без проверки доступен для диагностики")
Процедура РазборБезПроверки() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(),
		Новый Структура("ИдентификаторКлюча", "ключ-1"));

	Разобранное = JWT.Разобрать(Токен);

	Ожидаем.Что(Разобранное.Заголовок["kid"]).Равно("ключ-1");
	Ожидаем.Что(Разобранное.ПолезнаяНагрузка["sub"]).Равно("u");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Список поддерживаемых алгоритмов содержит только HMAC")
Процедура СписокПоддерживаемыхАлгоритмов() Экспорт

	Алгоритмы = JWT.ПоддерживаемыеАлгоритмы();

	Ожидаем.Что(Алгоритмы.Количество()).Равно(3);
	Ожидаем.Что(Алгоритмы.Найти("HS256")).Не_().ЭтоНеопределено();
	Ожидаем.Что(Алгоритмы.Найти("HS384")).Не_().ЭтоНеопределено();
	Ожидаем.Что(Алгоритмы.Найти("HS512")).Не_().ЭтоНеопределено();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Функция Секрет()

	Возврат "секрет-для-тестов-достаточной-длины";

КонецФункции

Функция ВJson(Знач Значение)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Функция КодироватьBase64Url(Знач Текст)

	Результат = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, "+", "-");
	Результат = СтрЗаменить(Результат, "/", "_");

	Пока Прав(Результат, 1) = "=" Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции
