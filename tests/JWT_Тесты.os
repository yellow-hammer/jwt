	Параметры.Добавить(Новый Структура("sub", "u"));
	Параметры.Добавить(Секрет());
	Параметры.Добавить(Новый Структура("Алгоритм", "RS256"));

	Ожидаем.Что(JWT).Метод("Подписать", Параметры).ВыбрасываетИсключение();

