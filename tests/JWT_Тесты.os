#Использовать asserts
#Использовать "../src"

////////////////////////////////////////////////////////////////////////////////
// Совместимость с эталонными реализациями

&Тест
&ОтображаемоеИмя("Подпись совпадает с эталонным токеном jwt.io")
Процедура ПодписьСовпадаетСЭталоном() Экспорт

	Нагрузка = Новый Соответствие();
	Нагрузка.Вставить("sub", "1234567890");
	Нагрузка.Вставить("name", "John Doe");
	Нагрузка.Вставить("iat", 1516239022);

	Токен = JWT.Подписать(Нагрузка, "your-256-bit-secret", Новый Структура("ДобавлятьВремяВыпуска", Ложь));

	Ожидаем.Что(Токен).Равно(
		"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
		+ ".eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ"
		+ ".SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Проверяется эталонный токен из RFC 7515, приложение A.1")
Процедура ПроверяетсяТокенИзRFC7515() Экспорт

	// Ключ приведён в RFC в кодировке base64url
	Ключ = Base64Значение(СтрЗаменить(СтрЗаменить(
		"AyM1SysPpbyDfgZld3umj1qzKObwVMkoqQ-EstJQLr_T-1qS0gZH75aKtMN3Yj0iPS4hcgUuTwjAzZr1Z9CAow",
		"-", "+"), "_", "/") + "==");

	Токен = "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9"
		+ ".eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ"
		+ ".dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk";

	Результат = JWT.Проверить(Токен, Ключ, Новый Структура("ПроверятьСрок", Ложь));

	Ожидаем.Что(Результат.Валиден, Результат.Ошибка).ЭтоИстина();
	Ожидаем.Что(Результат.ПолезнаяНагрузка["iss"]).Равно("joe");
	Ожидаем.Что(Результат.ПолезнаяНагрузка["http://example.com/is_root"]).ЭтоИстина();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Подпись и проверка

&ПараметризованныйТест(Имя = "Полный цикл подписи и проверки: {Параметры}")
&ИсточникЗначение("HS256")
&ИсточникЗначение("HS384")
&ИсточникЗначение("HS512")
Процедура ПолныйЦиклДляАлгоритма(Знач Алгоритм) Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "user-42"), Секрет(), Новый Структура("Алгоритм", Алгоритм));

	Результат = JWT.Проверить(Токен, Секрет());

	Ожидаем.Что(Результат.Валиден, Результат.Ошибка).ЭтоИстина();
	Ожидаем.Что(Результат.Заголовок["alg"]).Равно(Алгоритм);
	Ожидаем.Что(Результат.ПолезнаяНагрузка["sub"]).Равно("user-42");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Токен состоит из трёх частей, разделённых точкой")
Процедура ТокенСостоитИзТрёхЧастей() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет());

	Ожидаем.Что(СтрРазделить(Токен, ".", Истина).Количество()).Равно(3);

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Заголовок содержит alg и typ")
Процедура ЗаголовокСодержитАлгоритмИТип() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет());

	Разобранное = JWT.Разобрать(Токен);

	Ожидаем.Что(Разобранное.Заголовок["alg"]).Равно("HS256");
	Ожидаем.Что(Разобранное.Заголовок["typ"]).Равно("JWT");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Полезная нагрузка переносится без потерь, включая вложенные структуры")
Процедура ПолезнаяНагрузкаБезПотерь() Экспорт

	Роли = Новый Массив();
	Роли.Добавить("admin");
	Роли.Добавить("editor");

	Нагрузка = Новый Соответствие();
	Нагрузка.Вставить("sub", "user-42");
	Нагрузка.Вставить("roles", Роли);
	Нагрузка.Вставить("активен", Истина);
	Нагрузка.Вставить("лимит", 100);
	Нагрузка.Вставить("имя", "Иван Петров");

	Результат = JWT.Проверить(JWT.Подписать(Нагрузка, Секрет()), Секрет());

	Ожидаем.Что(Результат.Валиден, Результат.Ошибка).ЭтоИстина();
	Ожидаем.Что(Результат.ПолезнаяНагрузка["roles"].Количество()).Равно(2);
	Ожидаем.Что(Результат.ПолезнаяНагрузка["roles"][0]).Равно("admin");
	Ожидаем.Что(Результат.ПолезнаяНагрузка["активен"]).ЭтоИстина();
	Ожидаем.Что(Результат.ПолезнаяНагрузка["лимит"]).Равно(100);
	Ожидаем.Что(Результат.ПолезнаяНагрузка["имя"]).Равно("Иван Петров");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Время выпуска добавляется автоматически")
Процедура ВремяВыпускаДобавляетсяАвтоматически() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(), Новый Структура("ТекущееВремя", 1700000000));

	Ожидаем.Что(JWT.Разобрать(Токен).ПолезнаяНагрузка["iat"]).Равно(1700000000);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Отказы в проверке

&Тест
&ОтображаемоеИмя("Подделанная подпись отвергается")
Процедура ПодделаннаяПодписьОтвергается() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет());
	// Портим середину подписи: у последнего Base64URL-символа часть бит - padding.
	Части = СтрРазделить(Токен, ".", Истина);
	Подпись = Части[2];
	Середина = Цел(СтрДлина(Подпись) / 2);
	Символ = Сред(Подпись, Середина + 1, 1);
	ИспорченнаяПодпись = Лев(Подпись, Середина)
		+ ?(Символ = "A", "B", "A")
		+ Сред(Подпись, Середина + 2);
	Испорченный = Части[0] + "." + Части[1] + "." + ИспорченнаяПодпись;

	Результат = JWT.Проверить(Испорченный, Секрет());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("INVALID_SIGNATURE");
	Ожидаем.Что(Результат.ПолезнаяНагрузка, "Непроверенные данные не должны быть доступны").ЭтоНеопределено();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Подмена полезной нагрузки отвергается")
Процедура ПодменаПолезнойНагрузкиОтвергается() Экспорт

	Токен = JWT.Подписать(Новый Структура("role", "viewer"), Секрет());
	Части = СтрРазделить(Токен, ".", Истина);

	ПоддельнаяНагрузка = Новый Соответствие();
	ПоддельнаяНагрузка.Вставить("role", "admin");

	Подделка = Части[0] + "." + КодироватьBase64Url(ВJson(ПоддельнаяНагрузка)) + "." + Части[2];

	Ожидаем.Что(JWT.Проверить(Подделка, Секрет()).КодОшибки).Равно("INVALID_SIGNATURE");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Чужой секрет отвергается")
Процедура ЧужойСекретОтвергается() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет());

	Ожидаем.Что(JWT.Проверить(Токен, "другой секрет").КодОшибки).Равно("INVALID_SIGNATURE");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Алгоритм none запрещён всегда")
Процедура АлгоритмNoneЗапрещён() Экспорт

	ЗаголовокNone = Новый Соответствие();
	ЗаголовокNone.Вставить("alg", "none");
	ЗаголовокNone.Вставить("typ", "JWT");

	Нагрузка = Новый Соответствие();
	Нагрузка.Вставить("role", "admin");

	Токен = КодироватьBase64Url(ВJson(ЗаголовокNone)) + "." + КодироватьBase64Url(ВJson(Нагрузка)) + ".";

	Результат = JWT.Проверить(Токен, Секрет());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("ALGORITHM_NOT_ALLOWED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Алгоритм вне списка разрешённых отвергается")
Процедура АлгоритмВнеСпискаОтвергается() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(), Новый Структура("Алгоритм", "HS256"));

	Разрешённые = Новый Массив();
	Разрешённые.Добавить("HS512");

	Результат = JWT.Проверить(Токен, Секрет(), Новый Структура("Алгоритмы", Разрешённые));

	Ожидаем.Что(Результат.КодОшибки).Равно("ALGORITHM_NOT_ALLOWED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Критический заголовок crit отвергается")
Процедура КритическийЗаголовокОтвергается() Экспорт

	Расширения = Новый Массив();
	Расширения.Добавить("exp");

	Дополнительные = Новый Соответствие();
	Дополнительные.Вставить("crit", Расширения);

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(),
		Новый Структура("ДополнительныеЗаголовки", Дополнительные));

	Ожидаем.Что(JWT.Проверить(Токен, Секрет()).КодОшибки).Равно("UNSUPPORTED_CRITICAL_HEADER");

КонецПроцедуры

&ПараметризованныйТест(Имя = "Некорректный токен отвергается как MALFORMED: {Параметры}")
&ИсточникЗначение("")
&ИсточникЗначение("не токен")
&ИсточникЗначение("одна.часть")
&ИсточникЗначение("слишком.много.частей.тут")
&ИсточникЗначение("!!!.!!!.!!!")
Процедура НекорректныйТокенОтвергается(Знач Токен) Экспорт

	Результат = JWT.Проверить(Токен, Секрет());

	Ожидаем.Что(Результат.Валиден).ЭтоЛожь();
	Ожидаем.Что(Результат.КодОшибки).Равно("MALFORMED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Проверка не выбрасывает исключение на значении неверного типа")
Процедура ПроверкаУстойчиваКТипу() Экспорт

	Ожидаем.Что(JWT.Проверить(Неопределено, Секрет()).КодОшибки).Равно("MALFORMED");
	Ожидаем.Что(JWT.Проверить(42, Секрет()).КодОшибки).Равно("MALFORMED");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Сроки действия

&Тест
&ОтображаемоеИмя("Просроченный токен отвергается")
Процедура ПросроченныйТокенОтвергается() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(),
		Новый Структура("ВремяЖизни,ТекущееВремя", 3600, 1700000000));

	Результат = JWT.Проверить(Токен, Секрет(), Новый Структура("ТекущееВремя", 1700003601));

	Ожидаем.Что(Результат.КодОшибки).Равно("TOKEN_EXPIRED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Допуск компенсирует расхождение часов")
Процедура ДопускКомпенсируетРасхождениеЧасов() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(),
		Новый Структура("ВремяЖизни,ТекущееВремя", 3600, 1700000000));

	Параметры = Новый Структура();
	Параметры.Вставить("ТекущееВремя", 1700003630);
	Параметры.Вставить("Допуск", 60);

	Ожидаем.Что(JWT.Проверить(Токен, Секрет(), Параметры).Валиден).ЭтоИстина();

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Токен действителен ровно до момента истечения")
Процедура ГраницаСрокаДействия() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(),
		Новый Структура("ВремяЖизни,ТекущееВремя", 3600, 1700000000));

	Ожидаем.Что(JWT.Проверить(Токен, Секрет(), Новый Структура("ТекущееВремя", 1700003599)).Валиден,
		"За секунду до истечения токен ещё действителен").ЭтоИстина();
	Ожидаем.Что(JWT.Проверить(Токен, Секрет(), Новый Структура("ТекущееВремя", 1700003600)).КодОшибки,
		"В момент истечения токен уже недействителен").Равно("TOKEN_EXPIRED");

КонецПроцедуры

&Тест
&ОтображаемоеИмя("Токен до наступления nbf отвергается")
Процедура ТокенДоНаступленияNbfОтвергается() Экспорт

	Токен = JWT.Подписать(Новый Структура("sub", "u"), Секрет(),
		Новый Структура("ДействителенЧерез,ТекущееВремя", 600, 1700000000));

	Ожидаем.Что(JWT.Проверить(Токен, Секрет(), Новый Структура("ТекущееВремя", 1700000100)).КодОшибки).Равно("TOKEN_NOT_ACTIVE");
	Ожидаем.Что(JWT.Проверить(Токен, Секрет(), Новый Структура("ТекущееВремя", 1700000600)).Валиден).ЭтоИстина();

