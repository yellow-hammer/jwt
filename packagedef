////////////////////////////////////////////////////////////
// JSON Web Token (RFC 7519) и JSON Web Signature (RFC 7515).
////////////////////////////////////////////////////////////

Описание.Имя("jwt")
	.Версия("0.1.0")
	.Автор("Ivan Karlo")
	.АдресАвтора("i.karlo@outlook.com")
	.АдресРепозитория("https://github.com/yellow-hammer/jwt")
	.Описание("Подпись и проверка JWT на алгоритмах HS256, HS384, HS512. HMAC реализован по RFC 2104 без внешних компонент. Асимметрично подписанные токены проверяются внешним проверяющим, например jwt-verify.")
	.ВерсияСреды("2.0.0")

	.ВключитьФайл("docs")
	.ВключитьФайл("src")
	.ВключитьФайл("tasks")
	.ВключитьФайл("tests")
	.ВключитьФайл("CHANGELOG.md")
	.ВключитьФайл("CONTRIBUTING.md")
	.ВключитьФайл("LICENSE")
	.ВключитьФайл("packagedef")
	.ВключитьФайл("README.md")

	.РазработкаЗависитОт("1commands")
	.РазработкаЗависитОт("asserts")
	.РазработкаЗависитОт("coverage")
	.РазработкаЗависитОт("fs")
	// Только для тестов: проверка RS256 работает с любым объектом, у которого
	// есть метод Проверить, поэтому в рантайме зависимости нет
	.РазработкаЗависитОт("jwt-verify")
	.РазработкаЗависитОт("oneunit")

	.ОпределяетМодуль("JWT", "src/Модули/JWT.os")
	.ОпределяетКласс("JwtVerificationResult", "src/Классы/JwtVerificationResult.os")
	.ОпределяетКласс("HmacRfc2104", "src/Классы/HmacRfc2104.os")
;
