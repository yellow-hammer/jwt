// ==============================================================================
// ПРИМЕР: Проверка утверждений - издатель, аудитория и сроки
// Что делает: показывает, что проверка подписи сама по себе ничего не решает,
//             и как задать ожидаемые iss, aud, sub, срок действия и допуск
//             на расхождение часов.
// Термины:
//   iss (issuer) - кто выпустил токен.
//   aud (audience) - кому он адресован.
//   nbf (not before) - момент, раньше которого токен не действует.
//   Допуск - разрешённое расхождение часов между узлами, в секундах.
// ==============================================================================

#Использовать ".."

Секрет = "общий-секрет-сервиса-авторизации";

// Фиксируем «сейчас», чтобы пример давал одинаковый результат при каждом запуске
Сейчас = 1785875000;

// --- Токен для чужой аудитории ---
// Подпись верна, но токен выпущен для другого сервиса: без проверки aud
// его приняли бы

Параметры = Новый Структура();
Параметры.Вставить("Издатель", "auth.example.com");
Параметры.Вставить("Аудитория", "billing");
Параметры.Вставить("Субъект", "user-42");
Параметры.Вставить("ВремяЖизни", 3600);
Параметры.Вставить("ТекущееВремя", Сейчас);

Токен = JWT.Подписать(Новый Структура("role", "admin"), Секрет, Параметры);

Сообщить("Только подпись:        " + Строка(JWT.Проверить(Токен, Секрет,
	Новый Структура("ТекущееВремя", Сейчас)).Валиден));

Ожидания = Новый Структура();
Ожидания.Вставить("Аудитория", "dashboard");
Ожидания.Вставить("ТекущееВремя", Сейчас);

Отказ = JWT.Проверить(Токен, Секрет, Ожидания);

Сообщить("С проверкой аудитории: " + Строка(Отказ.Валиден) + " (" + Отказ.КодОшибки + ")");

Сообщить("");

// --- Полный набор ожиданий ---
// Проверяющая сторона объявляет, какой токен считает своим; всё остальное
// отвергается

Ожидания = Новый Структура();
Ожидания.Вставить("Издатель", "auth.example.com");
Ожидания.Вставить("Аудитория", "billing");
Ожидания.Вставить("Субъект", "user-42");
Ожидания.Вставить("ТекущееВремя", Сейчас);

Результат = JWT.Проверить(Токен, Секрет, Ожидания);

Сообщить("Все ожидания совпали:  " + Строка(Результат.Валиден));

// Издателей и аудиторий можно перечислить массивом: подходит любой из списка
Издатели = Новый Массив();
Издатели.Добавить("auth.example.com");
Издатели.Добавить("auth-backup.example.com");

Ожидания.Вставить("Издатель", Издатели);

Сообщить("Издатель из списка:    " + Строка(JWT.Проверить(Токен, Секрет, Ожидания).Валиден));

Сообщить("");

// --- Срок действия ---
// Допуск компенсирует расхождение часов между узлами

Истёкший = JWT.Проверить(Токен, Секрет, Новый Структура("ТекущееВремя", Сейчас + 3601));

Сообщить("Через час и секунду:   " + Строка(Истёкший.Валиден) + " (" + Истёкший.КодОшибки + ")");

СДопуском = Новый Структура();
СДопуском.Вставить("ТекущееВремя", Сейчас + 3601);
СДопуском.Вставить("Допуск", 30);

Сообщить("То же с допуском 30 с: " + Строка(JWT.Проверить(Токен, Секрет, СДопуском).Валиден));

Сообщить("");

// --- Отложенное вступление в силу ---

Отложенный = Новый Структура();
Отложенный.Вставить("ДействителенЧерез", 600);
Отложенный.Вставить("ВремяЖизни", 3600);
Отложенный.Вставить("ТекущееВремя", Сейчас);

ТокенСмены = JWT.Подписать(Новый Структура("sub", "user-42"), Секрет, Отложенный);

Ранний = JWT.Проверить(ТокенСмены, Секрет, Новый Структура("ТекущееВремя", Сейчас));
Поздний = JWT.Проверить(ТокенСмены, Секрет, Новый Структура("ТекущееВремя", Сейчас + 900));

Сообщить("Сразу после выпуска:   " + Строка(Ранний.Валиден) + " (" + Ранний.КодОшибки + ")");
Сообщить("Через 15 минут:        " + Строка(Поздний.Валиден));

Сообщить("");

// --- Обязательные утверждения ---
// ТребоватьСрок заставляет отвергать токены без exp

Бессрочный = JWT.Подписать(Новый Структура("sub", "user-42"), Секрет,
	Новый Структура("ТекущееВремя", Сейчас));

Обычная = JWT.Проверить(Бессрочный, Секрет, Новый Структура("ТекущееВремя", Сейчас));

Строгая = Новый Структура();
Строгая.Вставить("ТребоватьСрок", Истина);
Строгая.Вставить("ТекущееВремя", Сейчас);

Отклонён = JWT.Проверить(Бессрочный, Секрет, Строгая);

Сообщить("Без exp, обычная проверка: " + Строка(Обычная.Валиден));
Сообщить("Без exp, ТребоватьСрок:    " + Строка(Отклонён.Валиден) + " (" + Отклонён.КодОшибки + ")");

Сообщить("");

// --- Список разрешённых алгоритмов ---
// Список задаёт проверяющая сторона: значению alg из самого токена доверять
// нельзя, иначе подмена алгоритма пройдёт незамеченной

ТолькоHS256 = Новый Массив();
ТолькоHS256.Добавить("HS256");

Ограничение = Новый Структура();
Ограничение.Вставить("Алгоритмы", ТолькоHS256);
Ограничение.Вставить("ТекущееВремя", Сейчас);

ТокенHS512 = JWT.Подписать(Новый Структура("sub", "user-42"), Секрет,
	Новый Структура("Алгоритм, ТекущееВремя", "HS512", Сейчас));

ОтказПоАлгоритму = JWT.Проверить(ТокенHS512, Секрет, Ограничение);

Сообщить("HS256 в списке HS256: " + Строка(JWT.Проверить(Токен, Секрет, Ограничение).Валиден));
Сообщить("HS512 в списке HS256: " + Строка(ОтказПоАлгоритму.Валиден)
	+ " (" + ОтказПоАлгоритму.КодОшибки + ")");
