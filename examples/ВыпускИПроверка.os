// ==============================================================================
// ПРИМЕР: Выпуск и проверка - минимальный цикл работы с токеном
// Что делает: выпускает подписанный токен со сроком жизни, проверяет его тем же
//             секретом, читает утверждения и показывает, из чего токен состоит.
// Термины:
//   Утверждение (claim) - поле полезной нагрузки, например sub или exp.
//   Компактная сериализация - три части через точку: заголовок, нагрузка, подпись.
//   NumericDate - время в секундах с 1970-01-01T00:00:00Z (RFC 7519).
// ==============================================================================

#Использовать ".."

Секрет = "очень-длинный-секрет-который-знает-только-сервер";

// --- Выпуск токена ---
// ВремяЖизни в секундах заполняет exp, а iat проставляется автоматически

Нагрузка = Новый Структура("sub, role, tenant", "user-42", "admin", "shop-1");

Параметры = Новый Структура();
Параметры.Вставить("ВремяЖизни", 3600);
Параметры.Вставить("Издатель", "oneflag");
Параметры.Вставить("Аудитория", "dashboard");

Токен = JWT.Подписать(Нагрузка, Секрет, Параметры);

Сообщить("Токен:");
Сообщить(Токен);
Сообщить("");

// --- Из чего состоит токен ---
// Разобрать читает содержимое БЕЗ проверки подписи: годится только
// для диагностики и для чтения kid перед выбором ключа

Части = СтрРазделить(Токен, ".");
Сообщить("Частей в токене: " + Формат(Части.Количество(), "ЧГ=0; ЧН=0"));

Содержимое = JWT.Разобрать(Токен);

Сообщить("Заголовок:");
Для Каждого Элемент Из Содержимое.Заголовок Цикл
	Сообщить("  " + Элемент.Ключ + " = " + Строка(Элемент.Значение));
КонецЦикла;

Сообщить("Нагрузка:");
Для Каждого Элемент Из Содержимое.ПолезнаяНагрузка Цикл
	Сообщить("  " + Элемент.Ключ + " = " + Строка(Элемент.Значение));
КонецЦикла;

Сообщить("");

// --- Проверка ---
// Проверить не выбрасывает исключений: отказ возвращается в результате

Результат = JWT.Проверить(Токен, Секрет);

Сообщить("Валиден:  " + Строка(Результат.Валиден));
Сообщить("Субъект:  " + Результат.ПолезнаяНагрузка["sub"]);
Сообщить("Роль:     " + Результат.Утверждение("role"));

// Утверждение подставляет значение по умолчанию, если поля в токене нет
Сообщить("Отдел:    " + Результат.Утверждение("department", "не задан"));

Осталось = Результат.Утверждение("exp") - JWT.ТекущееВремя();
Сообщить("Осталось секунд: " + Формат(Осталось, "ЧГ=0; ЧН=0"));

Сообщить("");

// --- Чужой секрет ---
// Полезная нагрузка невалидного токена не возвращается: непроверенные данные
// не должны быть доступны

Чужой = JWT.Проверить(Токен, "другой-секрет");

Сообщить("Валиден:        " + Строка(Чужой.Валиден));
Сообщить("Код отказа:     " + Чужой.КодОшибки);
Сообщить("Описание:       " + Чужой.Ошибка);
Сообщить("Нагрузка пуста: " + Строка(Чужой.ПолезнаяНагрузка = Неопределено));

Сообщить("");

// --- Более длинный хеш ---
// На стойкость к подбору секрета длина хеша не влияет

Сообщить("Поддерживаемые алгоритмы: " + СтрСоединить(JWT.ПоддерживаемыеАлгоритмы(), ", "));

Параметры.Вставить("Алгоритм", "HS512");
Длинный = JWT.Подписать(Нагрузка, Секрет, Параметры);

Сообщить("Длина HS256: " + Формат(СтрДлина(Токен), "ЧГ=0; ЧН=0"));
Сообщить("Длина HS512: " + Формат(СтрДлина(Длинный), "ЧГ=0; ЧН=0"));
Сообщить("HS512 валиден: " + Строка(JWT.Проверить(Длинный, Секрет).Валиден));
