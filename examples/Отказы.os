// ==============================================================================
// ПРИМЕР: Отказы - разбор причин, по которым токен не принят
// Что делает: собирает набор заведомо плохих токенов, прогоняет их через одну
//             проверку и раскладывает коды отказа на ответы HTTP - так выглядит
//             обработчик авторизации в реальном сервисе.
// Термины:
//   Код отказа - машиночитаемая причина, например TOKEN_EXPIRED.
//   crit - заголовок JOSE с перечнем критических расширений (RFC 7515).
//   Алгоритм none - «токен без подписи»; классический способ обхода авторизации.
// ==============================================================================

#Использовать ".."

Секрет = "общий-секрет-сервиса-авторизации";
Сейчас = 1785875000;

// Хвост из пробелов для выравнивания колонок вывода
Отбивка = "                              ";

БазовыеПараметры = Новый Структура();
БазовыеПараметры.Вставить("Издатель", "auth.example.com");
БазовыеПараметры.Вставить("Аудитория", "dashboard");
БазовыеПараметры.Вставить("ВремяЖизни", 3600);
БазовыеПараметры.Вставить("ТекущееВремя", Сейчас);

Правильный = JWT.Подписать(Новый Структура("sub", "user-42"), Секрет, БазовыеПараметры);
Части = СтрРазделить(Правильный, ".");

// --- Подмена заголовка на alg: none ---
// none запрещён всегда, даже если он указан в списке разрешённых

ЗаголовокБезПодписи = "{""alg"":""none"",""typ"":""JWT""}";

Кодированный = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ЗаголовокБезПодписи, КодировкаТекста.UTF8));
Кодированный = СтрЗаменить(СтрЗаменить(Кодированный, Символы.ПС, ""), Символы.ВК, "");
Кодированный = СтрЗаменить(СтрЗаменить(СтрЗаменить(Кодированный, "+", "-"), "/", "_"), "=", "");

ТокенБезПодписи = Кодированный + "." + Части[1] + ".";

// --- Токен с критическим расширением ---
// RFC 7515 требует понимать всё перечисленное в crit; библиотека расширений
// не поддерживает и отказывает

Критические = Новый Массив();
Критические.Добавить("exp-policy");

СКритическим = Новый Структура();
СКритическим.Вставить("ТекущееВремя", Сейчас);
СКритическим.Вставить("ДополнительныеЗаголовки", Новый Структура("crit", Критические));

// --- Набор проверяемых случаев ---

Случаи = Новый Массив();
Случаи.Добавить(Новый Структура("Описание, Токен",
	"корректный токен", Правильный));
Случаи.Добавить(Новый Структура("Описание, Токен",
	"строка вместо токена", "совсем-не-токен"));
Случаи.Добавить(Новый Структура("Описание, Токен",
	"испорченная подпись", Части[0] + "." + Части[1] + ".AAAA"));
Случаи.Добавить(Новый Структура("Описание, Токен",
	"алгоритм none", ТокенБезПодписи));
Случаи.Добавить(Новый Структура("Описание, Токен",
	"заголовок crit", JWT.Подписать(Новый Структура("sub", "user-42"), Секрет, СКритическим)));

// Ожидания проверяющей стороны одни на все случаи
Ожидания = Новый Структура();
Ожидания.Вставить("Издатель", "auth.example.com");
Ожидания.Вставить("Аудитория", "dashboard");
Ожидания.Вставить("ТекущееВремя", Сейчас);

Сообщить("Случай                       Валиден  Код отказа");
Сообщить("---------------------------- -------- ---------------------------");

Для Каждого Случай Из Случаи Цикл

	Результат = JWT.Проверить(Случай.Токен, Секрет, Ожидания);

	Сообщить(Лев(Случай.Описание + Отбивка, 28) + " "
		+ Лев(Строка(Результат.Валиден) + Отбивка, 8) + " " + Результат.КодОшибки);

КонецЦикла;

Позже = Новый Структура();
Позже.Вставить("Издатель", "auth.example.com");
Позже.Вставить("Аудитория", "dashboard");
Позже.Вставить("ТекущееВремя", Сейчас + 7200);

Просроченный = JWT.Проверить(Правильный, Секрет, Позже);

Сообщить(Лев("проверен через два часа" + Отбивка, 28) + " "
	+ Лев(Строка(Просроченный.Валиден) + Отбивка, 8) + " " + Просроченный.КодОшибки);

ЧужойИздатель = Новый Структура();
ЧужойИздатель.Вставить("Издатель", "auth.другой-домен");
ЧужойИздатель.Вставить("ТекущееВремя", Сейчас);

Посторонний = JWT.Проверить(Правильный, Секрет, ЧужойИздатель);

Сообщить(Лев("ожидался другой издатель" + Отбивка, 28) + " "
	+ Лев(Строка(Посторонний.Валиден) + Отбивка, 8) + " " + Посторонний.КодОшибки);

Сообщить("");

// --- Код отказа в ответ HTTP ---
// Клиенту отдаём общие формулировки: подробности отказа - подсказка тому,
// кто подбирает токен

Ответы = Новый Соответствие();
Ответы.Вставить("MALFORMED", "401 Unauthorized: токен не разобран");
Ответы.Вставить("INVALID_SIGNATURE", "401 Unauthorized: подпись не совпала");
Ответы.Вставить("ALGORITHM_NOT_ALLOWED", "401 Unauthorized: алгоритм запрещён");
Ответы.Вставить("UNSUPPORTED_ALGORITHM", "401 Unauthorized: алгоритм неизвестен");
Ответы.Вставить("UNSUPPORTED_CRITICAL_HEADER", "401 Unauthorized: неизвестное расширение");
Ответы.Вставить("INVALID_TYPE", "401 Unauthorized: не тот тип токена");
Ответы.Вставить("TOKEN_EXPIRED", "401 Unauthorized: обновите токен");
Ответы.Вставить("TOKEN_NOT_ACTIVE", "401 Unauthorized: токен ещё не действует");
Ответы.Вставить("MISSING_CLAIM", "401 Unauthorized: токен неполный");
Ответы.Вставить("INVALID_ISSUER", "403 Forbidden: чужой издатель");
Ответы.Вставить("INVALID_AUDIENCE", "403 Forbidden: токен не для этого сервиса");
Ответы.Вставить("INVALID_SUBJECT", "403 Forbidden: не тот субъект");

Показать = Новый Массив();
Показать.Добавить(Просроченный.КодОшибки);
Показать.Добавить(Посторонний.КодОшибки);
Показать.Добавить("MALFORMED");
Показать.Добавить("ЧТО_ТО_НОВОЕ");

Для Каждого Код Из Показать Цикл

	// Запасной ответ обязателен: список кодов может пополниться в новой версии
	Ответ = Ответы[Код];
	Ответ = ?(Ответ = Неопределено, "401 Unauthorized: токен отклонён", Ответ);

	Сообщить("  " + Лев(Код + Отбивка, 28) + " -> " + Ответ);

КонецЦикла;

Сообщить("");

// --- Когда отказ действительно авария ---

Попытка
	JWT.Проверить(Правильный, "не тот секрет").ВыброситьЕслиНеВалиден();
Исключение
	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
